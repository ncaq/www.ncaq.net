{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "konoka": {
      "source": {
        "source": "github",
        "repo": "ncaq/konoka"
      }
    }
  },
  "enabledPlugins": {
    "haskell-tasuke@konoka": true,
    "kyosei@konoka": true,
    "nix-tasuke@konoka": true,
    "programming-tasuke@konoka": true,
    "web-tasuke@konoka": true
  },
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(./build:*)",
      "Bash(actionlint:*)",
      "Bash(cabal build:*)",
      "Bash(cabal check:*)",
      "Bash(cabal clean:*)",
      "Bash(cabal configure:*)",
      "Bash(cabal haddock:*)",
      "Bash(cabal help:*)",
      "Bash(cabal info:*)",
      "Bash(cabal list-bin:*)",
      "Bash(cabal list:*)",
      "Bash(cabal path:*)",
      "Bash(cabal repl:*)",
      "Bash(cabal run:*)",
      "Bash(cabal test:*)",
      "Bash(cabal update:*)",
      "Bash(cabal-gild:*)",
      "Bash(deadnix:*)",
      "Bash(editorconfig-checker:*)",
      "Bash(fourmolu:*)",
      "Bash(gen-hie:*)",
      "Bash(ghc-pkg describe:*)",
      "Bash(ghc-pkg field:*)",
      "Bash(ghci:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git tag:*)",
      "Bash(hlint:*)",
      "Bash(nix develop:*)",
      "Bash(nix flake:*)",
      "Bash(nixfmt:*)",
      "Bash(npm ci:*)",
      "Bash(npm exec --no:*)",
      "Bash(npm run build:*)",
      "Bash(npm run fix:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",
      "Bash(statix:*)",
      "Bash(typos:*)",
      "Bash(uv sync:*)",
      "Bash(zizmor:*)",
      "Skill(proofreading-ja)"
    ],
    "deny": ["Bash(npx:*)", "Bash(pnpm:*)", "Bash(pnpx:*)", "Bash(yarn:*)"]
  }
}
